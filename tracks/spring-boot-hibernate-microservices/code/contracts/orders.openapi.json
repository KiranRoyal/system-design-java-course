{
  "openapi": "3.0.3",
  "info": {
    "title": "Local orders learning API",
    "version": "1.0.0",
    "description": "Synthetic loopback-only teaching API. No authentication in this local profile. Do not expose publicly."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18082"
    }
  ],
  "paths": {
    "/orders": {
      "post": {
        "summary": "Place or reconcile an idempotent checkout",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "productId",
                  "quantity"
                ],
                "properties": {
                  "productId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Terminal business state, including rejection",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "productId",
                    "quantity",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "productId": {
                      "type": "integer"
                    },
                    "quantity": {
                      "type": "integer"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "PENDING",
                        "CONFIRMED",
                        "REJECTED"
                      ]
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Pending unknown inventory outcome; retry same intent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "productId",
                    "quantity",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "productId": {
                      "type": "integer"
                    },
                    "quantity": {
                      "type": "integer"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "PENDING",
                        "CONFIRMED",
                        "REJECTED"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "409": {
            "description": "Idempotency key reused with different request"
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "summary": "Read an order",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "productId",
                    "quantity",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "productId": {
                      "type": "integer"
                    },
                    "quantity": {
                      "type": "integer"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "PENDING",
                        "CONFIRMED",
                        "REJECTED"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown order"
          }
        }
      }
    }
  }
}
