{
  "openapi": "3.0.3",
  "info": {
    "title": "Local commerce learning API",
    "version": "1.0.0",
    "description": "Synthetic loopback-only teaching API. No authentication in this local profile. Do not expose publicly."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18081"
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "summary": "List inventory DTOs",
        "responses": {
          "200": {
            "description": "A bounded page of products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "stock",
                      "version"
                    ],
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      },
                      "stock": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "version": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid page or size"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      }
    },
    "/reservations": {
      "post": {
        "summary": "Reserve stock idempotently",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "productId",
                  "quantity"
                ],
                "properties": {
                  "productId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reserved or same reservation replayed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "key",
                    "productId",
                    "quantity",
                    "remaining"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "productId": {
                      "type": "integer"
                    },
                    "quantity": {
                      "type": "integer"
                    },
                    "remaining": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Unknown product"
          },
          "409": {
            "description": "Insufficient stock or conflicting idempotency key"
          }
        }
      }
    }
  }
}
